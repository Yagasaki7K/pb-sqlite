{
  "name": "pb-sqlite-workspace",
  "private": true,
  "version": "0.2.0",
  "description": "Polar Bear Database workspace",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "web"
  ],
  "scripts": {
    "build": "bun run --filter pb-sqlite build && bun run --cwd web build",
    "dev": "bun run --cwd web dev",
    "dev:lib": "bun run --filter pb-sqlite dev",
    "test": "bun run --filter pb-sqlite test",
    "test:e2e": "bun run --filter pb-sqlite test:e2e",
    "lint": "bun run --filter pb-sqlite lint",
    "typecheck": "bun run --filter pb-sqlite typecheck",
    "format": "bunx prettier --write .",
    "changeset": "bunx changeset",
    "ci": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@typescript-eslint/parser": "^8.18.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2"
  }
}
