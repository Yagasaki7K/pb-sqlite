{
  "name": "pbdb-workspace",
  "private": true,
  "version": "0.2.0",
  "description": "Polar Bear Database workspace",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=18" },
  "workspaces": ["packages/*", "examples/*", "web"],
  "scripts": {
    "build": "pnpm --filter pbdb build && pnpm --dir web build",
    "dev": "pnpm --filter pbdb dev",
    "test": "pnpm --filter pbdb test",
    "test:e2e": "pnpm --filter pbdb test:e2e",
    "lint": "pnpm --filter pbdb lint",
    "typecheck": "pnpm --filter pbdb typecheck",
    "format": "prettier --write .",
    "changeset": "changeset",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@typescript-eslint/parser": "^8.18.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2"
  }
}
